# Копируется в корень dist/ скриптом bin/build-dist.php. Правила — docs/specs/deploy.md.
# Цель: после выгрузки посетители сразу видят новую версию, статика не залипает в кеше.

AddDefaultCharset UTF-8
Options -Indexes
DirectoryIndex index.php

# PHP-приложение требует Apache 2.4 и mod_rewrite. Служебные каталоги закрыты.
RewriteEngine On
RewriteRule ^(?:app|templates|config|bin|var|docs|tests|\.git|\.github)(?:/|$) - [F,L]
RewriteRule ^router\.php$ - [F,L]
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^manifest\.webmanifest$ index.php [QSA,L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [QSA,L]

<FilesMatch "\.(sqlite|db|sql|tpl|log|ini|lock|zip)$">
    Require all denied
</FilesMatch>

# MIME-типы, которых может не быть в конфиге хостинга
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
    AddType text/javascript .js
    AddType application/manifest+json .webmanifest
</IfModule>

# Сжатие текстовых форматов
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/plain text/xml application/xml
</IfModule>

# Отключаем долгий кеш хостинга по умолчанию (если включён mod_expires)
<IfModule mod_expires.c>
    ExpiresActive Off
</IfModule>

<IfModule mod_headers.c>
    # Убираем суффикс -gzip из ETag, чтобы ревалидация (304) работала со сжатием
    RequestHeader edit "If-None-Match" "^\"(.*)-gzip\"$" "\"$1\""
    Header edit "ETag" "^\"(.*)-gzip\"$" "\"$1\""

    # HTML: браузер каждый раз сверяется с сервером — новые ссылки ?v= подхватываются сразу
    <FilesMatch "\.(html?|txt|xml)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # CSS и JS: версии в ссылках + обязательная перепроверка сохранённой копии
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, no-cache, max-age=0, must-revalidate"
    </FilesMatch>

    # Графика, шрифты и манифест: перепроверка даже при сохранении прежнего имени
    <FilesMatch "\.(webp|avif|png|jpe?g|gif|svg|ico|woff2?|webmanifest)$">
        Header set Cache-Control "public, no-cache, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>
