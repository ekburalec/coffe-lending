<?php foreach ($fields as $field): ?><div class="checkout__field"><label for="<?= e($field['id']) ?>"><?= e($field['label']) ?></label>
<?php if ($field['type'] === 'textarea'): ?><textarea class="admin__input" id="<?= e($field['id']) ?>" name="<?= e($field['name']) ?>" maxlength="<?= e($field['max']) ?>" aria-describedby="<?= e($field['error_id']) ?>"><?= e($field['value']) ?></textarea>
<?php else: ?><input class="admin__input" id="<?= e($field['id']) ?>" type="<?= e($field['type']) ?>" name="<?= e($field['name']) ?>" value="<?= e($field['value']) ?>" maxlength="<?= e($field['max']) ?>" autocomplete="<?= e($field['autocomplete'] ?? 'off') ?>" <?= !empty($field['required']) ? 'required' : '' ?> aria-invalid="<?= $field['error'] ? 'true' : 'false' ?>" aria-describedby="<?= e($field['error_id']) ?>"><?php endif; ?><span id="<?= e($field['error_id']) ?>" class="checkout__error"><?= e($field['error']) ?></span></div><?php endforeach; ?>
