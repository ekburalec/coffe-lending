{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "landing",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "-d",
        "extension=gd",
        "-d",
        "extension=zip",
        "-d",
        "display_errors=0",
        "-S",
        "localhost:8090",
        "router.php"
      ],
      "port": 8090
    },
    {
      "name": "landing-alt",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "-d",
        "extension=gd",
        "-d",
        "extension=zip",
        "-d",
        "display_errors=0",
        "-S",
        "localhost:8091",
        "router.php"
      ],
      "port": 8091
    },
    {
      "name": "landing-dist",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "-d",
        "extension=gd",
        "-d",
        "extension=zip",
        "-d",
        "display_errors=0",
        "-S",
        "localhost:8092",
        "-t",
        "dist",
        "dist/router.php"
      ],
      "port": 8092
    }
  ]
}
